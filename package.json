{
  "name": "tanstack-start-intlayer",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "start": "node .output/server/index.mjs",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "start:editor": "npx intlayer-editor start --with 'vite dev --port 3000'",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "intlayer:build": "intlayer build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "intlayer": "latest",
    "nitro": "^3.0.260610-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intlayer": "latest",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-intlayer": "latest",
    "intlayer-editor": "latest",
    "vitest": "^5.0.3",
    "web-vitals": "^6.2.3"
  }
}
